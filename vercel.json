{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/user/signup.cjs": { "runtime": "@vercel/node@3.x" },
    "api/user/signin.cjs": { "runtime": "@vercel/node@3.x" },
    "api/user/profile.cjs": { "runtime": "@vercel/node@3.x" },
    "api/user/forgot-password.cjs": { "runtime": "@vercel/node@3.x" },
    "api/user/reset-password.cjs": { "runtime": "@vercel/node@3.x" },
    "api/track.cjs": { "runtime": "@vercel/node@3.x" }
  },
  "rewrites": [
    { "source": "/api/user/signup", "destination": "/api/user/signup.cjs" },
    { "source": "/api/user/signin", "destination": "/api/user/signin.cjs" },
    { "source": "/api/user/profile", "destination": "/api/user/profile.cjs" },
    { "source": "/api/user/forgot-password", "destination": "/api/user/forgot-password.cjs" },
    { "source": "/api/user/reset-password", "destination": "/api/user/reset-password.cjs" },
    { "source": "/api/track", "destination": "/api/track.cjs" },
    { "source": "/((?!api/|assets/|favicon.ico|tagskills-logo.jpg).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "X-Frame-Options", "value": "DENY" }, { "key": "X-XSS-Protection", "value": "1; mode=block" }] }
  ]
}
